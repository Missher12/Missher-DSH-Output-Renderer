{
  "name": "@missher/dsh-output-renderer",
  "version": "0.1.3-rc.5",
  "description": "Four assistant output layouts with full reasoning, independent tool details, and frame-synchronized or fading text.",
  "type": "module",
  "license": "MIT",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "VALIDATION.md",
    "LICENSE",
    "NOTICE.md",
    "licenses/deepseek-harness-MIT.txt"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/schemastery": "3.18.4",
    "@deepseek-ai/dsh-client-ui-chat": "*"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/schemastery": "3.18.4",
    "@deepseek-ai/dsh-settings": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-chat": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-settings": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-locale": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-store": "0.2.0-rc.2",
    "@deepseek-ai/dsh-util-workspace-path": "0.2.0-rc.2",
    "@types/node": "22.20.0",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "6.0.3",
    "esbuild": "0.28.1",
    "vitest": "4.1.8",
    "jsdom": "29.1.1",
    "@testing-library/react": "16.3.2"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "node node_modules/typescript/bin/tsc -p tsconfig.host.json && node node_modules/typescript/bin/tsc -p tsconfig.client.json",
    "test": "node --no-experimental-webstorage node_modules/vitest/vitest.mjs run",
    "pack:bundle": "node scripts/pack.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Missher12/Missher-DSH-Output-Renderer.git"
  },
  "homepage": "https://github.com/Missher12/Missher-DSH-Output-Renderer",
  "bugs": {
    "url": "https://github.com/Missher12/Missher-DSH-Output-Renderer/issues"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "ui",
    "output-renderer"
  ]
}
